@page "/Account/Login"

<PageTitle>Log ind</PageTitle>

<div class="account-page">
    <MudPaper Class="fe-account-card" Elevation="2">
        <img src="img/hero-small.webp" alt="Venner på roadtrip" class="fe-account-image" />
        <div class="pa-6">
        <MudText Typo="Typo.h5" GutterBottom="true">Log ind</MudText>

        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@ErrorMessage</MudAlert>
        }

        <GoogleSignInForm ReturnUrl="@ReturnUrls.Safe(ReturnUrl)" />

        <MudText Typo="Typo.body2" Class="mt-4">
            Ny her? Åbn det invitationslink, du har fået, for at komme med.
        </MudText>
        </div>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "not-invited" => "Du har ikke en konto endnu. Åbn dit invitationslink for at komme med – eller spørg den, der har oprettet turen.",
        "failed" => "Login med Google mislykkedes. Prøv igen.",
        _ => null,
    };
}
