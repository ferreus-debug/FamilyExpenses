@page "/Account/Register"
@using FamilyExpenses.Application.Invitations
@inject RegistrationPolicy Policy
@inject InvitationService Invitations

<PageTitle>Kom med</PageTitle>

<div class="account-page">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">Kom med</MudText>

        @if (!_allowed)
        {
            <MudAlert Severity="Severity.Info">
                Du skal bruge et gyldigt invitationslink for at komme med. Spørg den, der har oprettet turen.
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mt-4">
                Har du allerede en konto? <a href="Account/Login">Log ind</a>
            </MudText>
        }
        else
        {
            @if (_preview is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Du er inviteret til <strong>@_preview.EventName</strong> som en del af <strong>@_preview.HouseholdName</strong>.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">
                    Du er den første bruger og bliver ejer af appen. Derefter kan andre kun komme med via invitation.
                </MudAlert>
            }

            <MudText Typo="Typo.body2">
                Log ind med din Google-konto. Har du ingen konto her endnu, oprettes den automatisk.
            </MudText>

            <GoogleSignInForm Invite="@InviteToken" />
        }
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "invite")]
    private string? InviteToken { get; set; }

    private bool _allowed;
    private InvitationPreview? _preview;

    protected override async Task OnInitializedAsync()
    {
        _allowed = await Policy.IsAllowedAsync(InviteToken);
        if (_allowed && !string.IsNullOrWhiteSpace(InviteToken))
        {
            _preview = await Invitations.PreviewAsync(InviteToken);
        }
    }
}
