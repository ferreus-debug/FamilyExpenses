@* Shows that an event is closed (waiting for approvals) or settled; nothing while it is open. *@
@switch (Status)
{
    case EventStatus.Closed:
        <MudChip T="string" Size="Size" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassTop">Venter på godkendelse</MudChip>
        break;
    case EventStatus.Settled:
        <MudChip T="string" Size="Size" Color="Color.Success" Icon="@Icons.Material.Filled.Lock">Afregnet</MudChip>
        break;
}

@code {
    [Parameter, EditorRequired]
    public EventStatus Status { get; set; }

    [Parameter]
    public Size Size { get; set; } = Size.Medium;
}
