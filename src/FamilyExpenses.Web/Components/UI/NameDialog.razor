@* Generic one-field dialog (new event, family name, rename). Returns the trimmed text. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_value" Label="@Label" Required="true" RequiredError="Skal udfyldes"
                          MaxLength="100" AutoFocus="true" Immediate="true" OnKeyUp="OnKeyUp" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annullér</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">@SubmitText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Label { get; set; } = "Navn";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Gem";

    private MudForm _form = default!;
    private string? _value;

    protected override void OnInitialized() => _value = Value;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (_form.IsValid && !string.IsNullOrWhiteSpace(_value))
        {
            Dialog.Close(DialogResult.Ok(_value.Trim()));
        }
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private void Cancel() => Dialog.Cancel();
}
