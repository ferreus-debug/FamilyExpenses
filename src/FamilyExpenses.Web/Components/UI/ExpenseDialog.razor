<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="Model.Description" Label="Hvad var det?" Placeholder="Fx indkøb, sommerhus, is"
                          MaxLength="200" AutoFocus="true" Immediate="true" />
            <MudStack Row="true" Spacing="2">
                <MudNumericField T="decimal?" @bind-Value="Model.Amount" Label="Beløb" Adornment="Adornment.End"
                                 AdornmentText="kr." Min="0" Format="N2" Culture="@Danish" HideSpinButtons="true" />
                <MudDatePicker @bind-Date="Model.Date" Label="Dato" DateFormat="dd-MM-yyyy" Culture="@Danish" />
            </MudStack>

            <MudSelect T="Guid?" @bind-Value="Model.PaidByParticipantId" Label="Betalt af"
                       ToStringFunc="@PayerName">
                @foreach (var household in Model.Households)
                {
                    @foreach (var p in household.Participants)
                    {
                        <MudSelectItem T="Guid?" Value="@p.Id">@p.Name (@household.Name)</MudSelectItem>
                    }
                }
            </MudSelect>

            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Deles mellem</MudText>
                    <MudText Typo="Typo.caption" data-testid="selected-weight">
                        @Model.SelectedCount @(Model.SelectedCount == 1 ? "person" : "personer") · vægt @Format.Weight(Model.SelectedWeight)
                    </MudText>
                </MudStack>
                <MudCheckBox T="bool" Value="Model.AllSelected" ValueChanged="Model.SelectAll" Label="Alle" Color="Color.Primary" />
                @foreach (var household in Model.Households)
                {
                    @if (household.Kind == HouseholdKind.ExtraPerson)
                    {
                        @foreach (var p in household.Participants)
                        {
                            <div class="ml-4">
                                <MudCheckBox T="bool" Value="Model.IsSelected(p.Id)" Color="Color.Primary"
                                             ValueChanged="v => Model.SetParticipant(p.Id, v)"
                                             Label="@($"{p.Name} ({Format.Weight(p.Weight)}, ekstra person)")" />
                            </div>
                        }

                        continue;
                    }

                    <div class="ml-4">
                        <MudCheckBox T="bool?" Value="Model.HouseholdState(household)" TriState="true"
                                     ValueChanged="_ => Model.ToggleHousehold(household)"
                                     Label="@household.Name" Color="Color.Primary" />
                        <div class="ml-8 d-flex flex-wrap">
                            @foreach (var p in household.Participants)
                            {
                                <MudCheckBox T="bool" Value="Model.IsSelected(p.Id)" Dense="true"
                                             ValueChanged="v => Model.SetParticipant(p.Id, v)"
                                             Label="@($"{p.Name} ({Format.Weight(p.Weight)})")" />
                            }
                        </div>
                    </div>
                }
            </div>

            <div>
                <MudText Typo="Typo.subtitle2">Billeder</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Fx kvitteringen. Højst @ExpensePicture.MaxPerExpense billeder.
                </MudText>
                <div class="fe-pictures mt-2" data-testid="expense-pictures">
                    @foreach (var id in Model.KeptPictureIds)
                    {
                        <div class="fe-picture">
                            <img src="@($"pictures/{id}?thumb=true")" alt="Billede" />
                            <MudIconButton Class="fe-picture-remove" Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                           OnClick="() => Model.RemovePicture(id)" aria-label="Fjern billede" />
                        </div>
                    }
                    @foreach (var picture in Model.NewPictures)
                    {
                        <div class="fe-picture">
                            <img src="@picture.PreviewUrl" alt="Nyt billede" />
                            <MudIconButton Class="fe-picture-remove" Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                           OnClick="() => Model.RemovePicture(picture)" aria-label="Fjern billede" />
                        </div>
                    }
                    @if (_readingPictures)
                    {
                        <div class="fe-picture fe-picture-add"><MudProgressCircular Indeterminate="true" Size="Size.Small" /></div>
                    }
                    else if (Model.CanAddPicture)
                    {
                        @* No capture attribute: phones offer both the camera and the photo library. *@
                        <label class="fe-picture fe-picture-add">
                            <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" />
                            <span>Tilføj</span>
                            <InputFile OnChange="AddPicturesAsync" accept="image/*" multiple hidden />
                        </label>
                    }
                </div>
                @if (_pictureError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_pictureError</MudAlert>
                }
            </div>

            @foreach (var error in _errors)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Annullér</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_readingPictures">Gem</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly System.Globalization.CultureInfo Danish = System.Globalization.CultureInfo.GetCultureInfo("da-DK");

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public ExpenseFormModel Model { get; set; } = default!;

    private IReadOnlyList<string> _errors = [];
    private bool _readingPictures;
    private string? _pictureError;

    private string PayerName(Guid? id) =>
        Model.Households.SelectMany(h => h.Participants.Select(p => (p, h)))
            .Where(x => x.p.Id == id)
            .Select(x => $"{x.p.Name} ({x.h.Name})")
            .FirstOrDefault() ?? string.Empty;

    private void Submit()
    {
        _errors = Model.Validate();
        if (_errors.Count == 0)
        {
            Dialog.Close(DialogResult.Ok(Model));
        }
    }

    private async Task AddPicturesAsync(InputFileChangeEventArgs e)
    {
        _readingPictures = true;
        _pictureError = null;
        var failed = 0;
        try
        {
            foreach (var file in e.GetMultipleFiles(ExpensePicture.MaxPerExpense))
            {
                if (!Model.CanAddPicture)
                {
                    break;
                }

                try
                {
                    Model.AddPicture(new NewPicture(
                        await ReadJpegAsync(file, 1600, ExpensePicture.MaxImageBytes),
                        await ReadJpegAsync(file, 320, ExpensePicture.MaxThumbnailBytes)));
                }
                catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException)
                {
                    failed++;
                }
            }
        }
        finally
        {
            _readingPictures = false;
        }

        if (failed > 0)
        {
            _pictureError = failed == 1 ? "Et billede kunne ikke læses." : $"{failed} billeder kunne ikke læses.";
        }
    }

    // The browser shrinks and re-encodes the photo (canvas → JPEG) before it is sent: a phone photo of
    // several MB becomes a few hundred KB, and the location data (EXIF) is dropped on the way.
    private static async Task<byte[]> ReadJpegAsync(IBrowserFile file, int maxSide, long maxBytes)
    {
        var resized = await file.RequestImageFileAsync(ExpensePicture.ContentType, maxSide, maxSide);
        await using var stream = resized.OpenReadStream(maxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        var bytes = buffer.ToArray();
        return ExpensePicture.IsJpeg(bytes) ? bytes : throw new InvalidOperationException("The browser did not produce a JPEG.");
    }
}
