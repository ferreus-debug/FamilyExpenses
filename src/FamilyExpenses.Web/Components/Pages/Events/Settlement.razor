@page "/events/{EventId:guid}/settlement"
@attribute [Authorize]
@inherits EventPageBase
@inject SettlementService SettlementService
@inject IJSRuntime JS

<PageTitle>Afregning · @(Details?.Name)</PageTitle>

@if (Details is null || _settlement is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-2">@Details.Name</MudText>
    <EventTabs EventId="EventId" Active="settlement" IsAdmin="Details.IsAdmin" />

    <ApprovalStatus Status="Details.Status" Approvals="Details.Approvals" IsAdmin="Details.IsAdmin"
                    MyHouseholdId="Details.MyHouseholdId" OnClose="CloseAsync" OnReopen="ReopenAsync"
                    OnApprove="ApproveAsync" OnWithdraw="WithdrawAsync" />

    @if (Details.IsSettled)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync" Class="mb-4">
            Kopiér som tekst
        </MudButton>
    }

    <SettlementSummary Settlement="_settlement" MyHouseholdId="Details.MyHouseholdId"
                       OnMarkPaid="MarkPaidAsync" OnRemovePayment="RemovePaymentAsync" OnShowBreakdown="ShowBreakdownAsync" />
}

@code {
    private SettlementDto? _settlement;

    protected override async Task ReloadAsync()
    {
        await base.ReloadAsync();
        if (Details is not null)
        {
            _settlement = await LoadAsync(() => SettlementService.GetAsync(EventId));
        }
    }

    private async Task CloseAsync()
    {
        if (await ConfirmAsync("Luk turen",
                "Er alle udgifter registreret? Når turen er lukket, kan ingen ændre udgifter eller husstande, og hver familie "
                + "og den ekstra person skal godkende. Når alle har godkendt, beregnes det endeligt, hvem der betaler hvem.",
                "Luk turen") == true
            && await RunAsync(() => Events.CloseAsync(EventId), "Turen er lukket – nu skal alle godkende."))
        {
            await ReloadAsync();
        }
    }

    private async Task ReopenAsync()
    {
        if (await ConfirmAsync("Genåbn turen",
                "Turen åbnes for ændringer igen, og alle godkendelser nulstilles. Registrerede betalinger bevares.",
                "Genåbn") == true
            && await RunAsync(() => Events.ReopenAsync(EventId), "Turen er genåbnet."))
        {
            await ReloadAsync();
        }
    }

    private async Task ApproveAsync(ApprovalDto approval)
    {
        if (await ConfirmAsync($"Godkend for {approval.Name}",
                $"Har {approval.Name} tjekket udgifterne, og er de korrekte? Når alle har godkendt, er beløbene endelige.",
                "Godkend") == true
            && await RunAsync(() => Events.ApproveAsync(EventId, approval.HouseholdId), $"{approval.Name} har godkendt."))
        {
            await ReloadAsync();
        }
    }

    private async Task WithdrawAsync(ApprovalDto approval)
    {
        if (await RunAsync(() => Events.WithdrawApprovalAsync(EventId, approval.HouseholdId), "Godkendelsen er trukket tilbage."))
        {
            await ReloadAsync();
        }
    }

    private async Task MarkPaidAsync(TransferDto transfer)
    {
        if (await ConfirmAsync("Markér som betalt",
                $"Har {transfer.FromName} betalt {Format.Money(transfer.Amount)} til {transfer.ToName}?",
                "Ja, det er betalt") == true
            && await RunAsync(
                () => SettlementService.RecordPaymentAsync(EventId, transfer.FromHouseholdId, transfer.ToHouseholdId, transfer.Amount),
                "Betalingen er registreret."))
        {
            await ReloadAsync();
        }
    }

    private async Task RemovePaymentAsync(PaymentDto payment)
    {
        if (await ConfirmAsync("Fortryd betaling",
                $"Vil du fjerne betalingen på {Format.Money(payment.Amount)} fra {payment.FromName} til {payment.ToName}?",
                "Fjern") == true
            && await RunAsync(() => SettlementService.RemovePaymentAsync(EventId, payment.Id), "Betalingen er fjernet."))
        {
            await ReloadAsync();
        }
    }

    private async Task ShowBreakdownAsync(HouseholdBalanceDto balance) =>
        await Dialogs.ShowAsync<BalanceBreakdownDialog>(
            $"Sådan er saldoen for {balance.Name} regnet ud",
            new DialogParameters<BalanceBreakdownDialog>
            {
                { d => d.Balance, balance },
                {
                    d => d.Payments,
                    _settlement!.Payments
                        .Where(p => p.FromHouseholdId == balance.HouseholdId || p.ToHouseholdId == balance.HouseholdId)
                        .OrderBy(p => p.Date)
                        .ToList()
                },
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true });

    private async Task CopyAsync()
    {
        var text = SettlementText.Build(Details!.Name, _settlement!);
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Afregningen er kopieret – indsæt den i en besked.", Severity.Success);
        }
        catch (JSException)
        {
            // Clipboard needs HTTPS; show the text so it can be copied by hand.
            await Dialogs.ShowMessageBoxAsync("Afregning", text);
        }
    }
}
