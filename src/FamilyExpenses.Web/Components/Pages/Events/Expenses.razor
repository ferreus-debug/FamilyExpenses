@page "/events/{EventId:guid}/expenses"
@attribute [Authorize]
@inherits EventPageBase
@inject ExpenseService ExpenseService
@inject ExpensePictureService PictureService
@inject TimeProvider Time

<PageTitle>Udgifter · @(Details?.Name)</PageTitle>

@if (Details is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudText Typo="Typo.h4" Class="mb-2">@Details.Name</MudText>
    <EventTabs EventId="EventId" Active="expenses" IsAdmin="Details.IsAdmin" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6">I alt: <span data-testid="expenses-total">@Format.Money(_expenses?.Sum(e => e.Amount) ?? 0)</span></MudText>
        @if (!Details.IsSettled)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync" Disabled="!HasParticipants">Tilføj udgift</MudButton>
        }
    </MudStack>

    @if (!HasParticipants)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">Tilføj familier og personer under "Husstande", før I registrerer udgifter.</MudAlert>
    }

    <MudTable Items="_expenses" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_expenses is null" Dense="true"
              Elevation="1">
        <HeaderContent>
            <MudTh>Dato</MudTh>
            <MudTh>Beskrivelse</MudTh>
            <MudTh Style="text-align:right">Beløb</MudTh>
            <MudTh>Betalt af</MudTh>
            <MudTh>Deles mellem</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Dato">@Format.Date(context.Date)</MudTd>
            <MudTd DataLabel="Beskrivelse">
                @context.Description
                @if (context.PictureIds.Count > 0)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ml-1"
                               StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="() => ShowPicturesAsync(context)"
                               aria-label="@($"Vis billeder af {context.Description}")" data-testid="show-pictures">
                        @context.PictureIds.Count
                    </MudButton>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">af @context.CreatedByName</MudText>
            </MudTd>
            <MudTd DataLabel="Beløb" Style="text-align:right">@Format.Money(context.Amount)</MudTd>
            <MudTd DataLabel="Betalt af">@context.PaidByName <MudText Typo="Typo.caption" Inline="true">(@context.PaidByHouseholdName)</MudText></MudTd>
            <MudTd DataLabel="Deles mellem">@context.SharedWithSummary</MudTd>
            <MudTd Style="white-space:nowrap">
                @if (context.CanEdit && !Details.IsSettled)
                {
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="() => EditAsync(context)"
                                   aria-label="@($"Ret {context.Description}")" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="() => RemoveAsync(context)" aria-label="@($"Slet {context.Description}")" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Image="img/empty-expenses.webp" Title="Ingen udgifter endnu">
                Tryk "Tilføj udgift", når nogen har lagt ud – fx for indkøb, benzin eller sommerhuset.
            </EmptyState>
        </NoRecordsContent>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<ExpenseDto>? _expenses;

    private bool HasParticipants => Details?.Households.Any(h => h.Participants.Count > 0) == true;

    protected override async Task ReloadAsync()
    {
        await base.ReloadAsync();
        if (Details is not null)
        {
            _expenses = await LoadAsync(() => ExpenseService.ListAsync(EventId)) ?? [];
        }
    }

    private async Task AddAsync()
    {
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        var myself = await GuessMyselfAsync();
        var model = new ExpenseFormModel(Details!.Households, today, myself);
        if (await ShowDialogAsync("Tilføj udgift", model)
            && await RunAsync(async () => await SavePicturesAsync(await ExpenseService.AddAsync(EventId, model.ToInput()), model), "Udgiften er gemt."))
        {
            await ReloadAsync();
        }
    }

    private async Task EditAsync(ExpenseDto expense)
    {
        var model = ExpenseFormModel.ForEdit(Details!.Households, expense);
        if (await ShowDialogAsync("Ret udgift", model)
            && await RunAsync(async () =>
            {
                await ExpenseService.UpdateAsync(EventId, expense.Id, model.ToInput());
                await SavePicturesAsync(expense.Id, model);
            }, "Udgiften er opdateret."))
        {
            await ReloadAsync();
        }
    }

    // Pictures are saved one by one after the expense itself, so a failing picture never loses the expense.
    private async Task SavePicturesAsync(Guid expenseId, ExpenseFormModel model)
    {
        foreach (var pictureId in model.RemovedPictureIds)
        {
            await PictureService.RemoveAsync(EventId, pictureId);
        }

        foreach (var picture in model.NewPictures)
        {
            await PictureService.AddAsync(EventId, expenseId, picture.Image, picture.Thumbnail);
        }
    }

    private async Task ShowPicturesAsync(ExpenseDto expense) =>
        await Dialogs.ShowAsync<PicturesDialog>(
            expense.Description,
            new DialogParameters<PicturesDialog> { { d => d.PictureIds, expense.PictureIds }, { d => d.Description, expense.Description } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true });

    private async Task RemoveAsync(ExpenseDto expense)
    {
        if (await ConfirmAsync("Slet udgift", $"Vil du slette \"{expense.Description}\" ({Format.Money(expense.Amount)})?", "Slet") == true
            && await RunAsync(() => ExpenseService.RemoveAsync(EventId, expense.Id), "Udgiften er slettet."))
        {
            await ReloadAsync();
        }
    }

    /// <summary>Default payer: the person in my household with my name, else its first person.</summary>
    private async Task<Guid?> GuessMyselfAsync()
    {
        var myHousehold = Details!.Households.FirstOrDefault(h => h.Id == Details.MyHouseholdId);
        if (myHousehold is null)
        {
            return null;
        }

        var name = (await AuthState).User.FindFirst("DisplayName")?.Value;
        return (myHousehold.Participants.FirstOrDefault(p => string.Equals(p.Name, name, StringComparison.CurrentCultureIgnoreCase))
            ?? myHousehold.Participants.FirstOrDefault())?.Id;
    }

    /// <summary>True when the user saved; the form's values are then in <paramref name="model"/>.</summary>
    private async Task<bool> ShowDialogAsync(string title, ExpenseFormModel model)
    {
        var dialog = await Dialogs.ShowAsync<ExpenseDialog>(
            title,
            new DialogParameters<ExpenseDialog> { { d => d.Model, model } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        return await dialog.Result is { Canceled: false };
    }
}
