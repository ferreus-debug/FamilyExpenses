@page "/"
@inherits AppComponentBase
@inject EventService Events

<PageTitle>Fællesudgifter</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <MudText Typo="Typo.h4" GutterBottom="true">Fællesudgifter</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Registrér fælles udgifter og få beregnet, hvem der skal betale hvad til hvem.
            Voksne tæller 1, børn tæller 0,5.
        </MudText>
        <MudButton Href="Account/Login" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Login">Log ind</MudButton>
    </NotAuthorized>
    <Authorized>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudText Typo="Typo.h4">Mine begivenheder</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateAsync">Ny begivenhed</MudButton>
        </MudStack>

        @if (_events is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_events.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                Du er ikke med i nogen begivenheder endnu. Opret en ny, eller brug invitationslinket fra den, der har oprettet jeres.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var e in _events)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.h6">@e.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(e.MyHouseholdName ?? (e.IsAdmin ? "Administrator" : ""))
                                </MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@Format.Money(e.Total)</MudText>
                                @if (e.IsSettled)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Lock">Afregnet</MudChip>
                                }
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Href="@($"events/{e.Id}")" Color="Color.Primary">Åbn</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<EventSummary>? _events;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            _events = await LoadAsync(() => Events.ListMineAsync()) ?? [];
        }
    }

    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameDialog>(
            "Ny begivenhed",
            new DialogParameters<NameDialog>
            {
                { d => d.Label, "Navn, fx \"Sommerhus 2026\"" },
                { d => d.SubmitText, "Opret" },
            });
        if (await dialog.Result is { Canceled: false, Data: string name })
        {
            Guid id = default;
            if (await RunAsync(async () => id = await Events.CreateAsync(name), "Begivenheden er oprettet."))
            {
                Navigation.NavigateTo($"events/{id}/households");
            }
        }
    }
}
